{
  "name": "@justaskmyai/dsh-plugin",
  "version": "0.1.0-alpha.0",
  "description": "Native DeepSeek Harness plugin for JAMA cross-owner identity, consent, External Sessions, and audit",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cjy4979/JustAskMyAI.git",
    "directory": "integrations/deepseek-harness"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "ai-agent",
    "mcp",
    "consent",
    "external-session",
    "audit"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
